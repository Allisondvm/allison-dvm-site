---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — Krista Allison, DVM"
  description="Get in touch about industry roles in pharmacovigilance, drug safety, medical affairs, and clinical research."
>
  <section class="max-w-2xl mx-auto px-6 pt-16 pb-20">
    <h1 class="text-4xl">Contact</h1>
    <p class="mt-5 text-lg text-[--color-ink]">
      I am open to industry roles in pharmacovigilance, drug safety, medical
      affairs, and clinical research, including remote positions. If you are
      building something in animal-health science and want a clinician's
      perspective on it, get in touch.
    </p>

    <div class="mt-8 space-y-4">
      <a
        href="mailto:hello@allisondvm.com"
        class="flex items-center justify-between rounded-md border border-[--color-line] px-5 py-4 no-underline hover:no-underline hover:border-[--color-accent] transition-colors"
      >
        <span class="text-[--color-ink]">Email</span>
        <span class="text-[--color-ink-dim] text-sm">hello@allisondvm.com &rarr;</span>
      </a>
      <a
        href="https://www.linkedin.com/in/krista-allison-6b597a365/"
        rel="me noopener"
        class="flex items-center justify-between rounded-md border border-[--color-line] px-5 py-4 no-underline hover:no-underline hover:border-[--color-accent] transition-colors"
      >
        <span class="text-[--color-ink]">LinkedIn</span>
        <span class="text-[--color-ink-dim] text-sm">Message me &rarr;</span>
      </a>
      <a
        href="https://scholar.google.com/citations?user=eGKo0RQAAAAJ"
        rel="me noopener"
        class="flex items-center justify-between rounded-md border border-[--color-line] px-5 py-4 no-underline hover:no-underline hover:border-[--color-accent] transition-colors"
      >
        <span class="text-[--color-ink]">Google Scholar</span>
        <span class="text-[--color-ink-dim] text-sm">Publications &rarr;</span>
      </a>
      <a
        href="https://orcid.org/0009-0008-4308-0318"
        rel="me noopener"
        class="flex items-center justify-between rounded-md border border-[--color-line] px-5 py-4 no-underline hover:no-underline hover:border-[--color-accent] transition-colors"
      >
        <span class="text-[--color-ink]">ORCID</span>
        <span class="text-[--color-ink-dim] text-sm">0009-0008-4308-0318 &rarr;</span>
      </a>
    </div>
  </section>
</Layout>
